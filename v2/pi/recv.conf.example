# copy to ~/.config/tpkbd/recv.conf; every line is optional, these are the defaults
[receiver]
# pointer speed multiplier: 1.0 sends the ThinkPad's motion as it is. Raise it if the
# target's pointer feels slow, lower it if it feels fast
# scale = 1.0

# How a pinch reaches the target: touchpad (two fingers on a virtual touchpad: the target zooms
# around the pointer like a laptop; Linux targets) or ctrlwheel (Ctrl + mouse wheel: zooms
# around the window, works anywhere). touchpad falls back to ctrlwheel if the Pi has no touchpad
# function
# pinch = touchpad
# touchpad: half the starting distance between the fingers, 40 units per mm (400 = 20 mm apart)
# half0 = 400
# ctrlwheel: wheel clicks per doubling of the pinch distance
# pinch_clicks = 6

# the Pi's green LED: on, off, or activity (lit only while input is being forwarded).
# Both links use it. It still blinks during boot, before this service starts
# led = on

# no data for this many seconds: release every key and button
# watchdog_s = 3
# no data for this many seconds: the sender is gone, exit
# dead_s = 30
