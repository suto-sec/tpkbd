#!/usr/bin/env python3
"""tpkbd-recv: turn the tpkbd line protocol into USB keyboard and mouse reports.

Reads what tpkbd-send writes (k/m/b/s/g/h lines, see v1/) and sends it to the USB
gadget made by tpkbd-hid.

  tpkbd-recv                   read stdin: started by the forced command in
                               ~/.ssh/authorized_keys (pi/authorized_keys.example)
  tpkbd-recv --serial PATH     read the UART wire; runs forever as a service
                               (pi/tpkbd-recv.service). Answers `hello` with READY
                               and every heartbeat with `ok`.

Settings (optional): ~/.config/tpkbd/recv.conf or --config, see pi/recv.conf.example
(pointer speed, pinch, timeouts and what the Pi's green LED does).
Standard library only.
"""
import argparse
import configparser
import importlib.machinery
import importlib.util
import math
import os
import select
import sys
import termios
import time

PROTO = 2                       # must match tpkbd-send
CONF_PATH = os.path.expanduser("~/.config/tpkbd/recv.conf")

DEFAULTS = {
    "scale": "1.0",         # pointer speed on the target, 1.0 = as sent
    "pinch_clicks": "6",    # Ctrl+wheel clicks per doubling of the pinch distance
    "half0": "400",         # touchpad pinch: half the starting finger distance (40 units/mm)
    "watchdog_s": "3",      # silence this long: release every key and button
    "dead_s": "30",         # silence this long: the sender is gone, exit
}

PINCH_MODES = ("touchpad", "ctrlwheel")
PINCH_DEFAULT = "touchpad"

USB_CHECK_S = 1.0           # how often the USB state is looked at, to tell the sender when it changes

LED_MODES = ("off", "on", "activity")
LED_DEFAULT = "on"
LED_DIRS = ("/sys/class/leds/ACT", "/sys/class/leds/led0")  # new and old kernel names
LED_FLASH_S = 0.08          # how long the LED stays lit after input in "activity" mode

EV_SYN, EV_KEY = 0, 1
WHEEL_UNITS = 15            # libinput: 15 scroll units per wheel click
CTRL = 0x01                 # left Ctrl, held while a pinch turns into Ctrl+wheel

# How long a write may wait for the host. GRUB and many BIOSes never read the mouse
# interface, so motion is dropped at once instead of stalling the keyboard behind it.
KEY_WAIT_S = 0.2
BUTTON_WAIT_S = 0.1         # a lost release would leave the button stuck
MOTION_WAIT_S = 0


def say(msg):
    print(f"tpkbd-recv: {msg}", file=sys.stderr, flush=True)


def load_hid():
    """tpkbd-hid has no .py extension: load it from next to this script."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "tpkbd-hid")
    loader = importlib.machinery.SourceFileLoader("tpkbd_hid", path)
    spec = importlib.util.spec_from_loader("tpkbd_hid", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


hid = load_hid()


def load_config(path=CONF_PATH):
    cp = configparser.ConfigParser(interpolation=None)
    cp.read_dict({"receiver": DEFAULTS})
    cp.read(path)  # a missing file just means defaults
    s = cp["receiver"]
    cfg = {k: float(s[k]) for k in DEFAULTS}
    cfg["pinch"] = s.get("pinch", PINCH_DEFAULT).strip().lower()
    if cfg["pinch"] not in PINCH_MODES:
        raise ValueError(f"pinch must be one of {', '.join(PINCH_MODES)}, not {cfg['pinch']!r}")
    cfg["led"] = s.get("led", LED_DEFAULT).strip().lower()
    if cfg["led"] not in LED_MODES:
        raise ValueError(f"led must be one of {', '.join(LED_MODES)}, not {cfg['led']!r}")
    return cfg


class Led:
    """The Pi's green LED: always off, always on, or lit while input is being forwarded.

    Needs write access to the LED's sysfs files (pi/60-tpkbd-hid.rules grants it to the
    tpkbd group). Without a LED or without access it only says so once and does nothing."""

    def __init__(self, mode, dirs=LED_DIRS):
        self.mode = mode
        self.dir = next((d for d in dirs if os.path.isdir(d)), None)
        self.lit = None             # unknown until the first write
        self.until = 0.0            # "activity": switch off at this monotonic time
        if self.dir is None:
            say("no ACT LED found: the led setting is ignored")
            return
        try:
            self._write("trigger", "none")
            self._set(mode == "on")
        except OSError as err:
            say(f"cannot control the LED ({err}): re-run pi/install.sh and reboot")
            self.dir = None

    def _write(self, name, value):
        with open(os.path.join(self.dir, name), "w") as f:
            f.write(value)

    def _set(self, on):
        if on != self.lit:
            self._write("brightness", "1" if on else "0")
            self.lit = on

    def flash(self, now):
        """Input was forwarded."""
        if self.dir is None or self.mode != "activity":
            return
        self.until = now + LED_FLASH_S
        try:
            self._set(True)
        except OSError:
            self.dir = None

    def tick(self, now):
        if self.dir is not None and self.mode == "activity" and self.lit and now >= self.until:
            try:
                self._set(False)
            except OSError:
                self.dir = None

    def timeout(self, now, default):
        """How long serve() may sleep: not past the moment the LED has to go dark."""
        if self.dir is not None and self.mode == "activity" and self.lit:
            return min(default, max(0.005, self.until - now))
        return default

    def close(self):
        """Leave the LED as the setting made it ("activity" goes dark)."""
        if self.dir is not None and self.mode == "activity":
            try:
                self._set(False)
            except OSError:
                pass


class Replayer:
    """Protocol lines in, HID reports out. A host that isn't reading is not an error."""

    def __init__(self, kbd_out, mouse_out, cfg, reply=None, consumer_out=None, led=None,
                 touch_out=None, usb_state=None):
        self.kbd_out, self.mouse_out = kbd_out, mouse_out
        self.consumer_out = consumer_out    # media keys; None if the gadget predates them
        self.touch_out = touch_out  # pinch as two fingers on a touchpad; None: Ctrl + wheel
        if cfg.get("pinch", PINCH_DEFAULT) == "ctrlwheel":
            self.touch_out = None
        self.led = led              # Led or None
        self.usb_state = usb_state  # callable -> the USB controller's state; reported to the sender
        self.usb_sent = None        # the last state reported (None: report again)
        self.usb_checked = 0.0
        self.reply = reply          # writes a line back to the sender (serial mode only)
        self.scale = cfg["scale"]
        self.pinch_clicks = cfg.get("pinch_clicks", 6.0)
        self.kb = hid.Keyboard()
        self.mouse = hid.Mouse()
        self.consumer = hid.Consumer()
        self.pending = []           # key events up to the next SYN
        self.rem_x = self.rem_y = self.rem_v = self.rem_h = 0.0
        self.half0 = cfg.get("half0", 400.0)
        self.touch = hid.Touchpad()
        self.pinch_base = 1.0       # touchpad pinch: the scale at which the fingers were put down
        self.pinching = False
        self.pinch_sent = 0         # wheel clicks already sent for the current pinch
        self.write_errors = 0

    def tick(self, now, force=False):
        """Called by serve() between reads: the LED, and the USB state for the sender."""
        if self.led is not None:
            self.led.tick(now)
        if self.usb_state is None or self.reply is None:
            return
        if force or now - self.usb_checked >= USB_CHECK_S:
            self.usb_checked = now
            state = self.usb_state()
            if state != self.usb_sent:
                self.usb_sent = state
                self.reply(f"usb {state}")

    def timeout(self, now, default):
        """How long serve() may sleep."""
        if self.led is not None:
            default = self.led.timeout(now, default)
        if self.usb_state is not None and self.reply is not None:
            default = min(default, max(0.01, self.usb_checked + USB_CHECK_S - now))
        return default

    def release_all(self):
        """Let go of everything: used when the sender goes quiet or disconnects."""
        self.pending.clear()
        self.pinching = False
        outs = [(self.kbd_out, self.kb.release_all()),
                (self.mouse_out, self.mouse.release_all())]
        if self.consumer_out is not None:
            outs.append((self.consumer_out, self.consumer.release_all()))
        if self.touch_out is not None:
            lift = self.touch.end()
            if lift:
                outs.append((self.touch_out, lift))
        for out, report in outs:
            try:
                out.send(report, BUTTON_WAIT_S)
            except OSError as err:
                say(f"release failed: {err}")

    def handle(self, line):
        p = line.split()
        if self.reply is not None:
            if p == ["hello"]:
                self.reply(f"READY {PROTO}")
                self.usb_sent = None        # a sender that just arrived wants to know now
                self.tick(time.monotonic(), force=True)
                return
            if p[:1] == ["h"]:
                self.reply("ok")
                return
        if len(p) != 4 or p[0] not in ("k", "m", "b", "s", "g"):
            return  # includes the "h" heartbeat: it only matters that it arrived
        if self.led is not None:
            self.led.flash(time.monotonic())
        try:
            self._dispatch(p)
        except (ValueError, OSError) as err:
            self.write_errors += 1
            if self.write_errors <= 3:
                say(f"bad or failed message {line!r}: {err}")

    def _dispatch(self, p):
        tag = p[0]
        if tag == "k":
            t, c, v = int(p[1]), int(p[2]), int(p[3])
            if t != EV_SYN:
                if t == EV_KEY:
                    self.pending.append((c, v))
                return
            changed = media = False
            for code, value in self.pending:
                changed |= self.kb.event(code, value)
                media |= self.consumer.event(code, value)
            self.pending.clear()
            if changed:
                self.kbd_out.send(self.kb.report(), KEY_WAIT_S)
            if media and self.consumer_out is not None:
                self.consumer_out.send(self.consumer.report(), KEY_WAIT_S)

        elif tag == "m":
            self.rem_x += float(p[1]) * self.scale
            self.rem_y += float(p[2]) * self.scale
            dx, dy = int(self.rem_x), int(self.rem_y)
            self.rem_x -= dx
            self.rem_y -= dy
            for report in self.mouse.moves(dx, dy):
                self.mouse_out.send(report, MOTION_WAIT_S)

        elif tag == "b":
            report = self.mouse.button(int(p[1]), int(p[2]))
            if report is not None:
                self.mouse_out.send(report, BUTTON_WAIT_S)

        elif tag == "s":
            # libinput: vertical positive is down but the HID wheel is positive up;
            # horizontal is positive to the right on both
            self.rem_v += -float(p[1]) / WHEEL_UNITS
            self.rem_h += float(p[2]) / WHEEL_UNITS
            clicks, pans = int(self.rem_v), int(self.rem_h)
            self.rem_v -= clicks
            self.rem_h -= pans
            for report in self.mouse.moves(0, 0, clicks, pans):
                self.mouse_out.send(report, MOTION_WAIT_S)

        elif tag == "g":
            if p[1] == "b":
                self.pinch_begin()
            elif p[1] == "u":
                self.pinch_update(float(p[2]))
            elif p[1] == "e":
                self.pinch_end()

    # Pinch. With a touchpad function the target sees two fingers moving apart or together,
    # which it turns into its own pinch gesture: zoom around the pointer, like a laptop.
    # Without one, a pinch becomes Ctrl + wheel, which zooms around the window instead.

    def pinch_begin(self):
        self.pinching, self.pinch_sent = True, 0
        if self.touch_out is not None:
            self.pinch_base = 1.0
            self.touch_out.send(self.touch.begin(self.half0), BUTTON_WAIT_S)

    def pinch_update(self, scale):
        if scale <= 0:
            raise ValueError(f"pinch scale {scale}")
        self.pinching = True
        if self.touch_out is not None:
            self.touch_update(scale)
            return
        target = round(math.log2(scale) * self.pinch_clicks)
        delta = target - self.pinch_sent
        if not delta:
            return
        if not self.kb.virtual_mods & CTRL:
            self.kb.virtual_mods |= CTRL
            self.kbd_out.send(self.kb.report(), KEY_WAIT_S)
        self.pinch_sent = target
        for report in self.mouse.moves(0, 0, delta):    # spreading fingers (scale > 1) is up: zoom in
            self.mouse_out.send(report, MOTION_WAIT_S)

    def touch_update(self, scale):
        if not self.touch.down:     # the begin was lost: start from here
            self.pinch_base = scale
            self.touch_out.send(self.touch.begin(self.half0), BUTTON_WAIT_S)
            return
        half = self.half0 * scale / self.pinch_base
        if not hid.TOUCH_MIN_HALF < half < hid.TOUCH_MAX_HALF:
            # the fake fingers ran out of pad: lift them and put them down in the middle
            # again, so a long pinch keeps zooming instead of stalling
            self.touch_out.send(self.touch.end(), BUTTON_WAIT_S)
            self.pinch_base = scale
            self.touch_out.send(self.touch.begin(self.half0), BUTTON_WAIT_S)
            return
        self.touch_out.send(self.touch.move(half), MOTION_WAIT_S)

    def pinch_end(self):
        self.pinching = False
        lift = self.touch.end()
        if lift and self.touch_out is not None:
            self.touch_out.send(lift, BUTTON_WAIT_S)
        if self.kb.virtual_mods & CTRL:
            self.kb.virtual_mods &= ~CTRL
            self.kbd_out.send(self.kb.report(), KEY_WAIT_S)


def serve(rp, fd, watchdog_s, dead_s):
    """Feed lines from `fd` to the replayer until EOF or `dead_s` of silence (0: never give up).

    The sender sends a heartbeat every second, so silence means the link is
    dead, not that the user is idle."""
    buf = b""
    last = time.monotonic()
    released = True  # nothing pressed yet
    while True:
        wait = rp.timeout(time.monotonic(), min(0.5, max(0.01, watchdog_s / 4)))
        try:
            r, _, _ = select.select([fd], [], [], wait)
        except OSError as err:
            say(f"port failed: {err}")
            break
        now = time.monotonic()
        rp.tick(now)
        if r:
            try:
                data = os.read(fd, 65536)
            except BlockingIOError:
                continue
            except OSError as err:
                say(f"read failed: {err}")
                break
            if not data:
                break
            last, released = now, False
            buf += data
            *lines, buf = buf.split(b"\n")
            for raw in lines:
                rp.handle(raw.decode(errors="replace"))
            continue
        idle = now - last
        if idle >= watchdog_s and not released:
            say(f"no data for {idle:.0f} s, releasing all keys and buttons")
            rp.release_all()
            released = True
        if dead_s and idle >= dead_s:
            say(f"no data for {idle:.0f} s, assuming the sender is gone")
            break
    rp.release_all()


def open_serial(path, baud):
    """Open a serial port raw, 8N1, no flow control, non-blocking."""
    speed = getattr(termios, f"B{baud}", None)
    if speed is None:
        sys.exit(f"tpkbd-recv: unsupported baud rate {baud}")
    try:
        fd = os.open(path, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
        attrs = termios.tcgetattr(fd)
        attrs[0] = attrs[1] = attrs[3] = 0
        attrs[2] = ((attrs[2] & ~(termios.CSIZE | termios.PARENB | termios.CSTOPB | termios.CRTSCTS))
                    | termios.CS8 | termios.CLOCAL | termios.CREAD)
        attrs[4] = attrs[5] = speed
        attrs[6][termios.VMIN] = attrs[6][termios.VTIME] = 0
        termios.tcsetattr(fd, termios.TCSANOW, attrs)
        termios.tcflush(fd, termios.TCIOFLUSH)
    except (OSError, termios.error) as err:
        sys.exit(f"tpkbd-recv: cannot use {path}: {err}")
    return fd


def serial_reply(fd):
    def reply(text):
        try:
            os.write(fd, (text + "\n").encode())
        except OSError:
            pass    # the sender is gone or the buffer is full: it will ask again
    return reply


def main():
    ap = argparse.ArgumentParser(description="Turn tpkbd protocol lines into USB HID reports.")
    ap.add_argument("--serial", metavar="PATH", help="read this serial port instead of stdin")
    ap.add_argument("--baud", type=int, default=115200)
    ap.add_argument("--config", default=CONF_PATH)
    args = ap.parse_args()
    try:
        cfg = load_config(args.config)
    except ValueError as err:
        sys.exit(f"tpkbd-recv: bad setting in {args.config}: {err}")
    try:
        kbd_out = hid.HidOut.open("/dev/hidg0")
        mouse_out = hid.HidOut.open("/dev/hidg1")
    except hid.HidError as err:
        sys.exit(f"tpkbd-recv: {err}")
    try:
        consumer_out = hid.HidOut.open("/dev/hidg2")
    except hid.HidError:
        consumer_out = None
        say("no /dev/hidg2: media keys are off until the gadget is recreated (re-run pi/install.sh, reboot)")
    try:
        touch_out = hid.HidOut.open("/dev/hidg3")
    except hid.HidError:
        touch_out = None
        if cfg["pinch"] == "touchpad":
            say("no /dev/hidg3: pinch uses Ctrl + wheel until the gadget is recreated "
                "(re-run pi/install.sh, reboot)")
    led = Led(cfg["led"])
    try:
        if args.serial:
            fd = open_serial(args.serial, args.baud)
            say(f"listening on {args.serial} at {args.baud} baud")
            serve(Replayer(kbd_out, mouse_out, cfg, reply=serial_reply(fd),
                           consumer_out=consumer_out, led=led, touch_out=touch_out,
                           usb_state=hid.udc_state),
                  fd, cfg["watchdog_s"], 0)
            return
        print(f"READY {PROTO}", flush=True)
        serve(Replayer(kbd_out, mouse_out, cfg, consumer_out=consumer_out, led=led,
                       touch_out=touch_out),
              0, cfg["watchdog_s"], cfg["dead_s"])
    finally:
        led.close()


if __name__ == "__main__":
    main()
