# copy to ~/.config/tpkbd/recv.conf; every line is optional, these are the defaults
[receiver]
# pointer sensitivity multiplier. 1.25 = PC width in px / ThinkPad logical width
# (1920 / 1536); raise it if the pointer feels slow, lower it if it feels fast
# scale = 1.25

# replay delay that smooths out Wi-Fi jitter; on Ethernet 0 is fine
# jitter_ms = 15

# half the starting finger distance for pinches (40 units per mm)
# half0 = 400

# no data for this many seconds: release every key and button
# watchdog_s = 3
# no data for this many seconds: the sender is gone, exit
# dead_s = 30
