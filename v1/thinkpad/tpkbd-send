#!/usr/bin/env python3
# tpkbd-send: forward the ThinkPad's keyboard, TrackPoint and touchpad to the PC.
#
#   tpkbd-send          keyboard mode: grab everything at once. Hold both Ctrl
#                       keys and press Esc to stop (exit code 42).
#   tpkbd-send --soft   desktop mode: nothing is grabbed until the toggle hotkey
#                       (both Ctrl keys + Space) hands the input to the PC; the
#                       same hotkey takes it back.
#
# Needs read/write access to /dev/input (root, or a user in the "input" group).
# Settings live in /etc/tpkbd/tpkbd.conf, see thinkpad/tpkbd.conf.example.
import argparse
import errno
import configparser
import os
import pty
import re
import select
import signal
import socket
import subprocess
import sys
import termios
import time

import evdev
from evdev import ecodes as e

PROTO = 2                       # must match tpkbd-recv
CONF_PATH = "/etc/tpkbd/tpkbd.conf"
STATE_PATH = "/run/tpkbd/state"  # "local" or "remote", only written in soft mode
EXIT_ESCAPE = 42

DEFAULTS = {
    "link": "ssh",                  # "ssh" (receiver on a PC) or "serial" (wire to the Pi)
    "ssh_config": "/etc/tpkbd/ssh_config",
    "host": "tpkbd-pc",
    "serial_port": "/dev/ttyUSB0",
    "baud": "115200",
    "ready_timeout": "15",
    "heartbeat_s": "1",
    "keyboard": "AT Translated Set 2 keyboard, ThinkPad Extra Buttons",
    "pointing": "TrackPoint, Synaptics TM3276",
    "libinput_opts": "--set-profile=adaptive --set-speed=0 --enable-tap --disable-dwt",
    # keys that are not forwarded (Fn+4 would suspend the PC)
    "block_keys": "KEY_SLEEP KEY_SUSPEND KEY_WAKEUP KEY_POWER",
    "escape_keys": "KEY_LEFTCTRL KEY_RIGHTCTRL KEY_ESC",
    "toggle_keys": "KEY_LEFTCTRL KEY_RIGHTCTRL KEY_SPACE",
    # soft mode: keep this laptop from suspending while input goes to the PC
    "inhibit_sleep": "yes",
}

# libinput debug-events output. Repeated events get a counter column before
# the timestamp, so that part is optional.
TS = r"\s+(?:\d+\s+)?[+-]?\d+\.\d+s\s+"
RE_MOTION = re.compile(r"POINTER_MOTION" + TS + r"(-?\d+\.\d+)/\s*(-?\d+\.\d+)")
RE_BUTTON = re.compile(r"POINTER_BUTTON" + TS + r"\S+ \((\d+)\) (pressed|released)")
RE_SCROLL = re.compile(r"POINTER_SCROLL_(?:FINGER|CONTINUOUS)" + TS +
                       r"vert (-?\d+\.\d+)/\S+ horiz (-?\d+\.\d+)/")
RE_PINCH_UPDATE = re.compile(r"GESTURE_PINCH_UPDATE.*unaccelerated\)\s+(-?\d+\.\d+) @")
# events we depend on: if one of these shows up but matches nothing above,
# libinput's output format has probably changed
RE_EXPECTED = re.compile(r"\b(?:POINTER_MOTION|POINTER_BUTTON|POINTER_SCROLL_FINGER|"
                         r"POINTER_SCROLL_CONTINUOUS|GESTURE_PINCH_UPDATE)\s")


def log(msg):
    print(f"tpkbd: {msg}", flush=True)


def now_us():
    return int(time.time() * 1_000_000)


class LinkError(Exception):
    pass


# ---------------------------------------------------------------- config

def split_names(text):
    return [x.strip() for x in text.split(",") if x.strip()]


def key_codes(text):
    codes = set()
    for name in text.replace(",", " ").split():
        if name not in e.ecodes:
            raise ValueError(f"unknown key name {name!r}")
        codes.add(e.ecodes[name])
    return frozenset(codes)


def load_config(path=CONF_PATH):
    cp = configparser.ConfigParser(interpolation=None)
    cp.read_dict({"sender": DEFAULTS})
    cp.read(path)  # a missing file just means defaults
    s = cp["sender"]
    if s["link"] not in ("ssh", "serial"):
        raise ValueError(f"link must be ssh or serial, not {s['link']!r}")
    if not hasattr(termios, f"B{int(s['baud'])}"):
        raise ValueError(f"unsupported baud rate {s['baud']}")
    return {
        "link": s["link"],
        "ssh_config": s["ssh_config"],
        "host": s["host"],
        "serial_port": s["serial_port"],
        "baud": int(s["baud"]),
        "ready_timeout": float(s["ready_timeout"]),
        "heartbeat_s": float(s["heartbeat_s"]),
        "keyboard": split_names(s["keyboard"]),
        "pointing": split_names(s["pointing"]),
        "libinput_opts": s["libinput_opts"].split(),
        "block_keys": key_codes(s["block_keys"]),
        "escape_keys": key_codes(s["escape_keys"]),
        "toggle_keys": key_codes(s["toggle_keys"]),
        "inhibit_sleep": s.getboolean("inhibit_sleep"),
    }


# ------------------------------------------------------- pure helpers

def parse_libinput_line(line):
    """Protocol payload (without timestamp) for one debug-events line, or None."""
    if "GESTURE_PINCH_BEGIN" in line:
        return "g b 1"
    if m := RE_PINCH_UPDATE.search(line):
        return f"g u {m[1]}"
    if "GESTURE_PINCH_END" in line:
        return "g e 1"
    if m := RE_MOTION.search(line):
        return f"m {m[1]} {m[2]}"
    if m := RE_BUTTON.search(line):
        return f"b {m[1]} {1 if m[2] == 'pressed' else 0}"
    if m := RE_SCROLL.search(line):
        return f"s {m[1]} {m[2]}"
    return None


def looks_parseable(line):
    return bool(RE_EXPECTED.search(line))


def chord_active(codes, held):
    return bool(codes) and codes <= held


def release_lines(keys, buttons, ts):
    """Protocol lines that let go of everything still pressed on the PC."""
    out = [f"k {e.EV_KEY} {code} 0" for code in sorted(keys)]
    if keys:
        out.append(f"k 0 0 {ts}")
    out += [f"b {code} 0 {ts}" for code in sorted(buttons)]
    return out


class RateLimited:
    """Lets the first few messages through, then one per `every` seconds."""

    def __init__(self, first=3, every=60.0):
        self.first, self.every = first, every
        self.count, self.last = 0, 0.0

    def ok(self, now=None):
        now = time.monotonic() if now is None else now
        self.count += 1
        if self.count <= self.first or now - self.last >= self.every:
            self.last = now
            return True
        return False


def sd_notify(msg):
    path = os.environ.get("NOTIFY_SOCKET")
    if not path:
        return
    if path[0] == "@":
        path = "\0" + path[1:]
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as s:
            s.connect(path)
            s.sendall(msg.encode())
    except OSError:
        pass


# What the Pi tells us about its USB link to the PC (`usb <state>`), in plain words.
USB_PROBLEMS = {
    "suspended": "the PC is asleep (its USB is suspended)",
    "not attached": "the Pi's USB gets no link from the PC (cable unplugged or bad, or the PC is off)",
    "no-controller": "the Pi has no USB device controller (is dtoverlay=dwc2 set in its config.txt?)",
}


def usb_problem(state):
    """None if the PC has set the Pi's USB up, else a sentence saying what is wrong."""
    if state == "configured":
        return None
    return USB_PROBLEMS.get(state, f"the PC has not finished setting up the Pi's USB (state: {state})")


# ------------------------------------------------------------ ssh link

class Link:
    """The ssh connection to tpkbd-recv on the PC."""

    def __init__(self, cfg, argv=None):
        self.cfg = cfg
        # -tt: with a pty, ssh sets TCP_NODELAY, otherwise small writes get delayed
        self.argv = argv or [
            "ssh", "-F", cfg["ssh_config"], "-tt", "-e", "none",
            "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
            "-o", "ServerAliveInterval=5", "-o", "ServerAliveCountMax=2",
            "-o", "UpdateHostKeys=no",
            cfg["host"]]
        self.proc = None
        self.fd = None
        self.eof = False
        self._buf = b""

    NUDGE_S = 1.0       # wait_ready calls nudge() this often while waiting

    def timeout_message(self):
        return "PC not reachable or receiver not ready (will retry)"

    def lost_reason(self):
        return "the ssh connection closed"

    @property
    def started(self):
        return self.proc is not None

    def start(self):
        self.proc = subprocess.Popen(self.argv, stdin=subprocess.PIPE,
                                     stdout=subprocess.PIPE, bufsize=0)
        self.fd = self.proc.stdout.fileno()

    def nudge(self):
        """Ask the receiver to announce itself again: not needed over ssh, it starts on connect."""

    def poll(self):
        return self.proc.poll()

    def send(self, lines):
        if not lines:
            return
        try:
            self.proc.stdin.write(("\n".join(lines) + "\n").encode())
            self.proc.stdin.flush()
        except (BrokenPipeError, OSError, ValueError):
            pass

    def read_lines(self):
        """Read what the PC printed. Never blocks if select() said it's readable."""
        chunk = os.read(self.fd, 4096)
        if not chunk:
            self.eof = True
            rest, self._buf = self._buf, b""
            return [rest.decode(errors="replace").strip()] if rest.strip() else []
        self._buf += chunk
        *lines, self._buf = self._buf.split(b"\n")
        return [x.decode(errors="replace").strip() for x in lines if x.strip()]

    def wait_ready(self, timeout, log=log):
        """Wait for the receiver's `READY <proto>`. Anything else it prints is logged."""
        deadline = time.monotonic() + timeout
        while True:
            left = deadline - time.monotonic()
            if left <= 0:
                raise LinkError(self.timeout_message())
            r, _, _ = select.select([self.fd], [], [], min(left, self.NUDGE_S))
            if not r:
                self.nudge()
                continue
            for line in self.read_lines():
                m = re.fullmatch(r"READY(?: (\d+))?", line)
                if not m:
                    log(f"pc: {line}")
                elif m[1] is None:
                    raise LinkError("receiver speaks protocol 1, this sender speaks "
                                    f"{PROTO}: re-run pc/install.sh on the PC")
                elif int(m[1]) != PROTO:
                    raise LinkError(f"receiver speaks protocol {m[1]}, this sender "
                                    f"speaks {PROTO}: update the older side")
                else:
                    return
            if self.eof:
                raise LinkError(self.timeout_message())

    def close(self):
        if self.proc is None:
            return
        try:
            self.proc.stdin.close()  # EOF: the receiver exits and drops its devices
        except (OSError, ValueError):
            pass
        try:
            self.proc.wait(timeout=1)
        except subprocess.TimeoutExpired:
            self.proc.terminate()
            try:
                self.proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        self.proc.stdout.close()


def open_serial(path, baud):
    """Open a serial port raw, 8N1, no flow control, non-blocking."""
    try:
        fd = os.open(path, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
    except OSError as err:
        hint = ""
        if err.errno == errno.ENOENT:
            hint = (": the USB-serial adapter is not detected by this laptop. Replug it, and check "
                    "that `lsusb` lists it (a CP2102 is 10c4:ea60) and `ls /dev/ttyUSB*` shows the port")
        elif err.errno == errno.EACCES:
            hint = ": no permission; the tpkbd user must be in the uucp (Arch) or dialout group"
        raise LinkError(f"cannot open {path}: {err.strerror}{hint}") from err
    try:
        attrs = termios.tcgetattr(fd)
        speed = getattr(termios, f"B{baud}")
        attrs[0] = attrs[1] = attrs[3] = 0
        attrs[2] = ((attrs[2] & ~(termios.CSIZE | termios.PARENB | termios.CSTOPB | termios.CRTSCTS))
                    | termios.CS8 | termios.CLOCAL | termios.CREAD)
        attrs[4] = attrs[5] = speed
        attrs[6][termios.VMIN] = attrs[6][termios.VTIME] = 0
        termios.tcsetattr(fd, termios.TCSANOW, attrs)
        termios.tcflush(fd, termios.TCIOFLUSH)
    except (termios.error, OSError) as err:
        os.close(fd)
        raise LinkError(f"cannot set up {path}: {err}") from err
    return fd


class SerialLink(Link):
    """The wire to tpkbd-recv on the Pi. The receiver is already running, so the sender
    says `hello` until it answers READY, and the receiver answers every heartbeat with
    `ok` so a dead Pi is noticed."""

    DEAD_S = 5.0
    NUDGE_S = 0.5
    USB_WAIT_S = 0.3        # the Pi's `usb` line follows READY within milliseconds

    def __init__(self, cfg):
        super().__init__(cfg, argv=[])
        self.ready = False
        self.last_rx = time.monotonic()
        self.rx_total = 0           # bytes ever received: 0 means the Pi never spoke

    @property
    def started(self):
        return self.fd is not None

    def start(self):
        self.fd = open_serial(self.cfg["serial_port"], self.cfg["baud"])
        self.last_rx = time.monotonic()
        self.nudge()

    def nudge(self):
        self.send(["hello"])

    def poll(self):
        if self.eof:
            return 1
        if self.ready and time.monotonic() - self.last_rx > self.DEAD_S:
            return 1
        return None

    def send(self, lines):
        if not lines or self.fd is None:
            return
        data = ("\n".join(lines) + "\n").encode()
        deadline = time.monotonic() + 2.0
        while data:
            try:
                data = data[os.write(self.fd, data):]
            except BlockingIOError:
                left = deadline - time.monotonic()
                if left <= 0:
                    return          # a full output buffer: drop rather than freeze the sender
                select.select([], [self.fd], [], left)
            except OSError:
                self.eof = True
                return

    def read_lines(self):
        try:
            chunk = os.read(self.fd, 4096)
        except BlockingIOError:
            return []
        except OSError:
            self.eof = True
            return []
        if not chunk:
            self.eof = True
            return []
        self.last_rx = time.monotonic()
        self.rx_total += len(chunk)
        self._buf += chunk
        *lines, self._buf = self._buf.split(b"\n")
        lines = [x.decode(errors="replace").strip() for x in lines if x.strip()]
        # heartbeat answers, and READY answers to a late `hello`, are not news
        return [x for x in lines if x != "ok" and not (self.ready and x.startswith("READY"))]

    def timeout_message(self):
        port = self.cfg["serial_port"]
        if self.eof:
            return f"{port} went away while waiting: the USB-serial adapter was unplugged or failed"
        if self.rx_total == 0:
            return (f"the Pi did not answer on {port}. It may still be booting (it starts together "
                    "with the PC and needs about 30 s), the Pi may be unpowered (is the PC on?), "
                    "the TX/RX wires may be swapped or loose, or tpkbd-recv is not running on the Pi "
                    "(systemctl status tpkbd-recv). Will retry")
        return (f"{port} receives data but no READY: wrong baud rate (set to {self.cfg['baud']}), "
                "a wire picking up noise, or the Pi runs another program on its serial port. Will retry")

    def lost_reason(self):
        if self.eof:
            return "the USB-serial adapter was unplugged or failed"
        return ("the Pi stopped answering for %d s: it lost power (the PC shut down or its USB port "
                "was switched off), it is rebooting, or its receiver crashed" % self.DEAD_S)

    def wait_ready(self, timeout, log=log):
        super().wait_ready(timeout, log)
        self.ready = True
        self.last_rx = time.monotonic()
        # the Pi follows READY with `usb <state>`; give it a moment so the first words
        # we log can already say whether the PC is listening. Older receivers say nothing.
        self.first_usb = []
        deadline = time.monotonic() + self.USB_WAIT_S
        while not self.first_usb and time.monotonic() < deadline:
            r, _, _ = select.select([self.fd], [], [], 0.05)
            if r:
                self.first_usb = [x for x in self.read_lines() if x.startswith("usb ")]

    def close(self):
        if self.fd is not None:
            try:
                termios.tcdrain(self.fd)    # let the release lines leave the adapter
            except (termios.error, OSError):
                pass
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = None


def make_link(cfg):
    return SerialLink(cfg) if cfg["link"] == "serial" else Link(cfg)


# -------------------------------------------------------------- sender

class SleepInhibitor:
    """Holds a logind "sleep" and "idle" block lock while input goes to the PC, so the laptop
    does not suspend (and then need the power button) during a long session on the PC.
    The lock lives as long as the `systemd-inhibit` child. The lid switch is not affected."""
    CMD = ["systemd-inhibit", "--what=sleep:idle", "--who=tpkbd", "--mode=block",
           "--why=forwarding the keyboard to the PC", "sleep", "infinity"]

    def __init__(self, enabled, cmd=None):
        self.enabled = enabled
        self.cmd = cmd or self.CMD
        self.proc = None
        self.warn = RateLimited()

    @property
    def held(self):
        return self.proc is not None and self.proc.poll() is None

    def hold(self):
        """Take the lock, or take it again if the child died."""
        if not self.enabled or self.held:
            return
        if self.proc is not None and self.warn.ok():
            log(f"the sleep lock ended (exit {self.proc.returncode}); taking it again")
        try:
            self.proc = subprocess.Popen(self.cmd, stdin=subprocess.DEVNULL,
                                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as err:
            self.proc = None
            if self.warn.ok():
                log(f"cannot keep the laptop awake ({err}); set inhibit_sleep = no to silence this")

    def release(self):
        proc, self.proc = self.proc, None
        if proc is None:
            return
        proc.terminate()
        try:
            proc.wait(2)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()


class Sender:
    def __init__(self, cfg, soft=False, link=None):
        self.cfg = cfg
        self.soft = soft
        self.link = link
        self.kbds = []
        self.pointing_paths = []
        self.li = None
        self.master = None
        self.li_buf = b""
        self.state = "local"
        self.usb_state = None       # what the Pi reports about its USB link to the PC
        self.want = None            # "remote"/"local": toggle waiting for all keys up
        self.held = set()           # physical keys currently down
        self.forwarded = set()      # keys the PC currently sees as down
        self.buttons = set()        # pointer buttons the PC sees as down
        self.batch = []
        self.next_hb = 0.0
        self.warn = RateLimited()
        self.inhibitor = SleepInhibitor(soft and cfg["inhibit_sleep"])

    # devices

    def open_devices(self):
        def find(names):
            found = []
            for path in evdev.list_devices():
                try:
                    d = evdev.InputDevice(path)
                except PermissionError:
                    sys.exit(f"tpkbd: no permission on {path}: run as root or "
                             "as a user in the input group")
                if any(n in d.name for n in names):
                    found.append(d)
                else:
                    d.close()
            return found

        self.kbds = find(self.cfg["keyboard"])
        pointing = find(self.cfg["pointing"])
        if not self.kbds or not pointing:
            sys.exit(f"missing devices: keyboard={[d.name for d in self.kbds]} "
                     f"pointing={[d.name for d in pointing]}")
        self.pointing_paths = [d.path for d in pointing]
        for d in pointing:
            d.close()
        for d in self.kbds:
            self.held.update(d.active_keys())

    def _grab_all(self):
        grabbed = []
        try:
            for d in self.kbds:
                d.grab()
                grabbed.append(d)
        except OSError:
            for d in grabbed:
                d.ungrab()
            raise

    def _ungrab_all(self):
        for d in self.kbds:
            try:
                d.ungrab()
            except OSError:
                pass

    def start_libinput(self):
        # libinput on a pty so its output isn't buffered; LC_ALL=C pins the number format
        master, slave = pty.openpty()
        dev_args = [a for p in self.pointing_paths for a in ("--device", p)]
        self.li = subprocess.Popen(
            ["libinput", "debug-events", "--grab", *dev_args, *self.cfg["libinput_opts"]],
            stdin=subprocess.DEVNULL, stdout=slave, stderr=subprocess.DEVNULL,
            env={**os.environ, "LC_ALL": "C"})
        os.close(slave)
        self.master = master
        self.li_buf = b""

    def stop_libinput(self):
        if self.li is not None:
            self.li.terminate()  # exiting drops its grab on the pointing devices
            try:
                self.li.wait(timeout=2)
            except subprocess.TimeoutExpired:
                self.li.kill()
                self.li.wait()
            self.li = None
        if self.master is not None:
            os.close(self.master)
            self.master = None
        self.li_buf = b""

    # state

    def status_text(self):
        problem = usb_problem(self.usb_state) if self.usb_state else None
        return self.state + (f" - but {problem}" if problem else "")

    def note_usb(self, state):
        """The Pi told us the state of its USB link to the PC."""
        if state == self.usb_state:
            return
        self.usb_state = state
        problem = usb_problem(state)
        if problem:
            log(f"PC USB problem: {problem}; keys and mouse will not reach the PC until this clears")
        else:
            log("PC USB link is up")
        sd_notify(f"STATUS={self.status_text()}")

    def on_pc_line(self, line):
        if line.startswith("usb ") and len(line.split()) >= 2:
            self.note_usb(line[4:].strip())
        else:
            log(f"pc: {line}")

    def set_state(self, state):
        self.state = state
        if not self.soft:
            return
        sd_notify(f"STATUS={self.status_text()}")
        try:
            with open(STATE_PATH, "w") as f:
                f.write(state + "\n")
        except OSError:
            pass

    def enter_remote(self):
        self._grab_all()
        try:
            self.start_libinput()
        except OSError:
            self._ungrab_all()
            raise
        self.forwarded.clear()
        self.buttons.clear()
        self.batch.clear()
        self.set_state("remote")
        self.inhibitor.hold()

    def leave_remote(self):
        self.link.send(release_lines(self.forwarded, self.buttons, now_us()) +
                       [f"g e 1 {now_us()}"])
        self.forwarded.clear()
        self.buttons.clear()
        self.batch.clear()
        self.stop_libinput()
        self._ungrab_all()
        self.inhibitor.release()
        self.set_state("local")

    def request_toggle(self):
        if self.want:
            return
        self.want = "local" if self.state == "remote" else "remote"
        if self.state == "remote":
            # let go on the PC right away; the grab itself waits for all keys up
            self.link.send(release_lines(self.forwarded, self.buttons, now_us()))
            self.forwarded.clear()
            self.buttons.clear()
            self.batch.clear()
        log(f"hotkey: switching to {self.want} once all keys are released")

    def apply_toggle(self):
        """Grabbing or ungrabbing while a key is down would leave it stuck on one side."""
        if not self.want or self.held:
            return
        want, self.want = self.want, None
        try:
            if want == "remote":
                self.enter_remote()
            else:
                self.leave_remote()
            log(f"input is now {self.state}")
        except OSError as err:
            log(f"switching to {want} failed: {err}")

    # events

    def handle_key(self, ev):
        if ev.type == e.EV_SYN:
            if ev.code == e.SYN_REPORT and self.batch:
                self.batch.append(f"k 0 0 {ev.sec * 1_000_000 + ev.usec}")
                self.link.send(self.batch)
                self.batch = []
            return
        if ev.type != e.EV_KEY or ev.value == 2:  # the PC does its own key repeat
            return
        pressed = ev.value != 0
        (self.held.add if pressed else self.held.discard)(ev.code)
        if pressed:
            if not self.soft and chord_active(self.cfg["escape_keys"], self.held):
                log("stopped (escape hotkey)")
                sys.exit(EXIT_ESCAPE)
            if self.soft and chord_active(self.cfg["toggle_keys"], self.held):
                self.request_toggle()
                return
        if self.state != "remote" or self.want or ev.code in self.cfg["block_keys"]:
            return
        (self.forwarded.add if pressed else self.forwarded.discard)(ev.code)
        self.batch.append(f"k {ev.type} {ev.code} {ev.value}")

    def handle_libinput(self):
        try:
            self.li_buf += os.read(self.master, 4096)
        except OSError:
            log("libinput stopped")
            sys.exit(1)
        *lines, self.li_buf = self.li_buf.split(b"\n")
        out = []
        for raw in lines:
            line = raw.decode(errors="replace")
            payload = parse_libinput_line(line)
            if payload is None:
                if looks_parseable(line) and self.warn.ok():
                    log(f"unparsed libinput line (did its format change?): {line.strip()!r}")
                continue
            if payload.startswith("b "):
                _, code, down = payload.split()
                (self.buttons.add if down == "1" else self.buttons.discard)(int(code))
            out.append(f"{payload} {now_us()}")
        self.link.send(out)

    def heartbeat(self, now):
        if now >= self.next_hb:
            self.link.send([f"h {now_us()}"])
            self.next_hb = now + self.cfg["heartbeat_s"]
            if self.state == "remote":
                self.inhibitor.hold()       # a no-op unless the lock was lost

    # main loop

    def run(self):
        self.open_devices()
        log("connecting to the PC...")
        t0 = time.monotonic()
        self.link = make_link(self.cfg)
        self.link.start()
        self.link.wait_ready(self.cfg["ready_timeout"])  # nothing is grabbed before this
        for line in getattr(self.link, "first_usb", []):
            self.on_pc_line(line)
        if not self.soft:
            if self.usb_state and usb_problem(self.usb_state):
                log("WARNING: taking over the keyboard anyway; hold both Ctrl + Esc to stop")
            self.enter_remote()
        log(f"CONNECTED after {time.monotonic() - t0:.1f} s " +
            ("(toggle with the hotkey)" if self.soft else "(hold both Ctrl + Esc to stop)"))
        sd_notify("READY=1\nSTATUS=" + self.status_text())
        kbd_fds = {d.fd: d for d in self.kbds}
        while True:
            fds = list(kbd_fds)
            if self.master is not None:
                fds.append(self.master)
            if not self.link.eof:
                fds.append(self.link.fd)
            timeout = max(0.0, min(1.0, self.next_hb - time.monotonic()))
            ready, _, _ = select.select(fds, [], [], timeout)
            for fd in ready:
                if fd == self.master:
                    self.handle_libinput()
                elif fd == self.link.fd:
                    for line in self.link.read_lines():
                        self.on_pc_line(line)
                else:
                    for ev in kbd_fds[fd].read():
                        self.handle_key(ev)
            self.apply_toggle()
            self.heartbeat(time.monotonic())
            if self.link.poll() is not None:
                why = getattr(self.link, "lost_reason", lambda: "")()
                log("connection lost" + (f": {why}" if why else ""))
                sys.exit(1)
            if self.li is not None and self.li.poll() is not None:
                log("libinput stopped")
                sys.exit(1)

    def shutdown(self):
        if self.link is not None and self.link.started:
            # the PC would otherwise keep anything still pressed
            self.link.send(release_lines(self.forwarded, self.buttons, now_us()))
        self.stop_libinput()
        self._ungrab_all()
        self.inhibitor.release()
        if self.link is not None:
            self.link.close()
        if self.soft:
            self.set_state("local")


def main(argv=None):
    ap = argparse.ArgumentParser(description="Forward this laptop's input to a PC.")
    ap.add_argument("--soft", action="store_true",
                    help="desktop mode: the toggle hotkey switches between local and remote")
    ap.add_argument("--config", default=CONF_PATH)
    args = ap.parse_args(argv)
    try:
        cfg = load_config(args.config)
    except (ValueError, KeyError, configparser.Error) as err:
        sys.exit(f"tpkbd: bad config {args.config}: {err}")
    # exit through `finally` on systemctl stop; 0 tells tpkbd-screen to restore the panel
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    sender = Sender(cfg, soft=args.soft)
    try:
        sender.run()
    except LinkError as err:
        sys.exit(f"tpkbd: {err}")
    finally:
        sender.shutdown()


if __name__ == "__main__":
    main()
